# Copy this file to .env and fill in whichever services you want to check.
# Leave a service's variables blank/unset and it will be skipped, not errored.

# --- ServiceNow (team workload) ---
SNOW_INSTANCE_URL=https://yourinstance.service-now.com
SNOW_USERNAME=svc-daily-checks
SNOW_PASSWORD=
# Optional: filter to one assignment group. Leave blank to see all open incidents.
SNOW_ASSIGNMENT_GROUP=Security Operations

# --- Microsoft Sentinel / Defender (Log Analytics workspace) ---
# Requires an Azure AD app registration with "Log Analytics Reader" (or
# "Microsoft Sentinel Reader") on the workspace below.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
LOG_ANALYTICS_WORKSPACE_ID=

# --- Armis ---
ARMIS_BASE_URL=https://yourtenant.armis.com
ARMIS_SECRET_KEY=

# --- Report options ---
DAILY_CHECKS_OUTPUT_DIR=./daily_checks_reports
DAILY_CHECKS_LOOKBACK_HOURS=24
